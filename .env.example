# SocioSolve Environment Configuration (Example)
# Rename this file to .env and fill in your actual values.

NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (e.g., Supabase, Heroku, or local Postgres)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME

# JWT Authentication
# Generate a secure random string for JWT_SECRET (e.g. using `require('crypto').randomBytes(32).toString('hex')`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# File Upload Settings
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE=5242880
