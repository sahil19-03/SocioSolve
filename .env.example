# SocioSolve Environment Configuration (Example)
# Rename this file to .env and fill in your actual values.

NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (e.g., Supabase, Heroku, or local Postgres)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME

# JWT Authentication
# Generate a secure random string for JWT_SECRET (e.g. using `require('crypto').randomBytes(32).toString('hex')`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Destructive demo seeder: only use against a disposable development/test database.
# Set SEED_ALLOW_DATABASE_RESET=true only when you intend to drop and recreate its tables.
SEED_ALLOW_DATABASE_RESET=false
# Replace this with a unique password of at least 16 characters before seeding.
SEED_DEMO_PASSWORD=replace-with-a-unique-local-password

# File Upload Settings
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE=5242880
